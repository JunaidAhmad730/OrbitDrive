# ==========================================
# OrbitDrive API Environment Configuration
# ==========================================

NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://username:password@localhost:5432/orbitdrive

JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

TELEGRAM_CLIENT_ID=your_client_id
TELEGRAM_CLIENT_SECRET=your_client_secret
TELEGRAM_REDIRECT_URI=http://localhost:3000/auth/callback

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000